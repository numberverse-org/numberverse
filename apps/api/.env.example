# Local/dev defaults. NV_ENVIRONMENT=dev allows the built-in dev JWT secret
# and admin password. For ANY non-dev deployment you MUST set NV_ENVIRONMENT
# to something else (e.g. production) and set both secrets below to strong,
# non-default values — the API refuses to start otherwise (#842).
NV_ENVIRONMENT=dev
NV_DATABASE_URL=postgresql+psycopg://numberverse:numberverse_dev@localhost:5434/numberverse
# REQUIRED in non-dev environments (#842) — use a strong, non-default secret.
# This value is the dev default; the guard rejects it in non-dev environments.
NV_JWT_SECRET=numberverse-dev-secret-change-me
NV_JWT_EXPIRES_MINUTES=10080
NV_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
NV_ADMIN_EMAIL=admin@numberverse.dev
# REQUIRED in non-dev environments (#842) — use a strong, non-default password.
NV_ADMIN_PASSWORD=change-me-admin
# Seeded demo parent (#800). REQUIRED non-default in non-dev environments.
NV_DEMO_EMAIL=demo@numberverse.dev
NV_DEMO_PASSWORD=demo1234
