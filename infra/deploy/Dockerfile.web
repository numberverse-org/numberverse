# Numberverse web — kid PWA (root) + parent portal (/parent) + admin console (/admin),
# all built on the demo box, served statically by nginx (which proxies /api → api:8000).
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate
WORKDIR /repo
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/kid/package.json apps/kid/
COPY apps/parent/package.json apps/parent/
COPY apps/admin/package.json apps/admin/
COPY packages/core/package.json packages/core/
RUN pnpm install --frozen-lockfile
COPY packages/core packages/core
RUN pnpm --filter core build
COPY apps/kid apps/kid
COPY apps/parent apps/parent
COPY apps/admin apps/admin

# kid PWA
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL:-/api/v1}
RUN pnpm --filter kid build

# parent portal (Next.js static export) — basePath baked into asset URLs
ARG NEXT_PUBLIC_BASE_PATH
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH:-/parent}
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-/api/v1}
RUN pnpm --filter parent build && test -d apps/parent/out

# admin console — base /admin/
ARG VITE_ADMIN_BASE
ENV VITE_ADMIN_BASE=${VITE_ADMIN_BASE:-/admin/}
RUN pnpm --filter admin build

# ── On-device neural Bangla voice (Piper VITS) ───────────────────────────────
# Downloads the voice assets + quantizes the fp32 model (77MB → ~20MB int8,
# weight-only QDQ — keeps fp32 Conv kernels so onnxruntime-web runs it).
# Baked into the image at build time: repo stays lean, the payload is a cached
# Docker layer. The PWA runtime-caches these on first use → fully offline.
FROM python:3.12-slim AS voice
ARG VOICE_MODEL_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/bn/bn_BD/google/medium/bn_BD-google-medium.onnx
COPY infra/deploy/scripts/fetch_voice_assets.sh /tmp/fetch_voice_assets.sh
COPY infra/deploy/scripts/quantize_voice.py /tmp/quantize_voice.py
RUN apt-get update && apt-get install -y --no-install-recommends curl tar \
    && sh /tmp/fetch_voice_assets.sh /voice "${VOICE_MODEL_URL}" \
    && pip install --no-cache-dir "numpy<2" "onnx==1.16.1" onnxruntime==1.17.0 \
    && python3 /tmp/quantize_voice.py /voice/bn_BD-google-medium.onnx /voice/bn_BD-google-medium.onnx

# Precompress the big static files — each gains a <file>.gz served by nginx
# gzip_static when the client accepts gzip. Cuts first-run wire bytes ~30%
# (phoneme data 18→~11MB, ORT 1.17 simd wasm 10.5→~4MB, int8 model 20→~17MB).
# ORT is 1.17 (the classic-loader engine piper-wasm was built around — ORT
# 1.20+ needs import() of an .mjs which Safari classic workers can't do); the
# int8 model is unchanged — int4 stays a QA artifact pending human listen-QA.
RUN python3 - <<'PY'
import gzip, os, shutil
root = "/voice"
for name in ("piper_phonemize.js", "piper_phonemize.wasm", "piper_phonemize.data",
             "onnx/ort.min.js", "onnx/ort-wasm-simd.wasm",
             "bn_BD-google-medium.onnx", "bn_BD-google-medium.onnx.json"):
    p = os.path.join(root, name)
    if not os.path.exists(p):
        continue
    out = p + ".gz"
    with open(p, "rb") as f, gzip.GzipFile(out, "wb", compresslevel=9) as g:
        shutil.copyfileobj(f, g)
    print(f"gzip {name}: {os.path.getsize(p)/1e6:.1f}MB -> {os.path.getsize(out)/1e6:.1f}MB")
PY

RUN rm -rf /tmp/fetch_voice_assets.sh /tmp/quantize_voice.py /root/.cache/pip

FROM nginx:1.27-alpine
COPY infra/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/kid/dist /usr/share/nginx/html
COPY --from=build /repo/apps/parent/out /usr/share/nginx/html/parent
COPY --from=build /repo/apps/admin/dist /usr/share/nginx/html/admin
COPY --from=voice /voice /usr/share/nginx/html/voice

EXPOSE 80
