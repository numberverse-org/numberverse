# Numberverse API — FastAPI + uv, runs on the demo box
# #919 — pinned digest (no floating tag) so rebuilds can't drift on a new uv image.
FROM ghcr.io/astral-sh/uv:python3.12-alpine@sha256:138f90e67682b923c4bbcc91d2bae98434e8ba8b32b555e390b055b504f69f91
ENTRYPOINT []
WORKDIR /app

# deps first (layer-cached)
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev

# source
COPY apps/api/app ./app

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
  CMD uv run --frozen python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1
# #923 — trust nginx's X-Forwarded-* headers (the API is only reachable through
# the web container here) so request.client.host — used by auth/session/rate
# limiting — sees the real client IP, matching the host-run dev path instead of
# always reporting the web container's private IP.
CMD ["uv", "run", "--frozen", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
