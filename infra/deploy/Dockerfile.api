# Numberverse API — FastAPI + uv, runs on the demo box
FROM ghcr.io/astral-sh/uv:python3.12-alpine
ENTRYPOINT []
WORKDIR /app

# deps first (layer-cached)
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev

# source
COPY apps/api/app ./app

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
  CMD uv run --frozen python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1
CMD ["uv", "run", "--frozen", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
