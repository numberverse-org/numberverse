# Numberverse API — FastAPI + uv, runs on the demo box
# #919 — pinned digest (no floating tag) so rebuilds can't drift on a new base.
# #921-era infra note: ghcr.io is unreachable from the demo box's ISP (GitHub
# Asia IPs dropped), so the base is the SAME runtime (python:3.12-alpine + uv)
# sourced from Docker Hub + PyPI instead of ghcr.io. Both digests are pinned.
FROM python:3.12-alpine@sha256:78098ea6a3a9c6a7727a5d4674e4a44e57e01fac878ee9cb4d24a86bd93916ff
ENTRYPOINT []
WORKDIR /app

# uv 0.12.5 pinned (same reproducibility intent as #919) — installed from PyPI
# because ghcr.io is unreachable from the box. Ships a musllinux x86_64 wheel.
# #2652 — the box's ISP intermittently times out PyPI/file-host fetches, so a
# slow single download used to abort the whole image build. Long timeout + retries
# make the tiny uv fetch resilient to those blips.
RUN pip install --no-cache-dir --timeout 120 --retries 5 "uv==0.12.5"

# deps first (layer-cached)
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --retries 5 --timeout 120

# source
COPY apps/api/app ./app

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
  CMD uv run --frozen python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1
# #923/#1760 — trust nginx's X-Forwarded-* headers (the API is only reachable
# through the web container here) so request.client.host — used by auth/session/
# rate limiting — sees the real client IP, matching the host-run dev path
# instead of always reporting the web container's private IP.
# #1760 — the trust is now SCOPED to the docker bridge subnet (the compose
# default network the nginx `web` container sits on), NOT '*' — a non-bridge
# attacker connecting directly can't mint a fresh bucket or dodge an ip-side
# lockout by injecting a leftmost X-Forwarded-For value. 172.16/12 covers the
# bridge network range without trusting arbitrary external peers. 127.0.0.1
# (the in-container healthcheck) is always trusted by uvicorn.
CMD ["uv", "run", "--frozen", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "172.16.0.0/12"]
