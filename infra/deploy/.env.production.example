# Numberverse demo — copy to .env.production on the box and edit.
# #921 — the secret placeholders below are intentionally EMPTY. deploy.sh and
# the API refuse to boot production until they are set, so a first deploy can
# never ship demo credentials.
NV_ENVIRONMENT=production

# Postgres — REQUIRED — CHANGE ME (generate with: openssl rand -hex 16)
NV_PG_USER=numberverse
NV_PG_PASSWORD=
NV_PG_DB=numberverse
# Optional: set NV_DATABASE_URL to a full URL for an external database. When
# unset, docker-compose.prod.yml derives it from the NV_PG_* values above.
# NV_DATABASE_URL=postgresql+psycopg://numberverse:CHANGE_ME@postgres:5432/numberverse

# REQUIRED — CHANGE ME — openssl rand -hex 32
NV_JWT_SECRET=
NV_JWT_EXPIRES_MINUTES=10080

# CORS — production is same-origin behind nginx, so allow exactly the public
# origin(s), never "*" (the API rejects a wildcard on any non-dev boot).
NV_CORS_ORIGINS=https://kids.munna-khan.xyz

# Admin console login — REQUIRED — CHANGE ME (must NOT be "change-me-admin")
NV_ADMIN_EMAIL=admin@numberverse.dev
NV_ADMIN_PASSWORD=

# Google sign-in (optional) — leave both empty to hide "Continue with Google".
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth Client
#    ID → Web application → Authorized JavaScript origins: https://kids.munna-khan.xyz
# 2. Paste the same Client ID into BOTH lines below:
#    - NV_GOOGLE_CLIENT_ID → the API verifies the ID token server-side
#    - VITE_GOOGLE_CLIENT_ID → baked into the kid PWA build (shows the button)
NV_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Tunnel: the box's EXISTING named tunnel (systemd `cloudflared`, id
# 7d5273d2-31dc-41ca-94b0-d36c1ad2d5a0) — remotely managed in the dashboard.
# No tunnel config needed here; just point its ingress rule at http://localhost:8080.
