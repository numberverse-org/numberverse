# bKash SOCKS5 tunnel — a minimal autossh container that keeps an SSH -D
# (dynamic SOCKS5) forward to the bKash-whitelisted VPS alive. The API reaches
# it at socks5h://bkash-tunnel:1080 (set NV_BKASH_PROXY_URL). The SSH private
# key and config are mounted read-only at runtime (see docker-compose.prod.yml),
# never baked into the image.
FROM alpine:3.19

RUN apk add --no-cache autossh openssh-client

# #1748-fix — OpenSSH running as root REFUSES a ~/.ssh/config (and private key)
# that it does not own; the compose bind-mounts the host's files read-only, so
# they keep the HOST owner (uid 1000) inside the container and ssh exits with
# "Bad owner or permissions on /root/.ssh/config" forever. Copy them into a
# root-owned location at container start, then exec autossh against that copy.
# The mounts stay read-only (never baked), so secrets still come from the box.
ENTRYPOINT ["/bin/sh", "-c", "set -e; mkdir -p /root/.ssh; cp /mnt/tunnel/config /root/.ssh/config; chown root:root /root/.ssh/config; chmod 600 /root/.ssh/config; if [ -f /mnt/tunnel/id_rsa ]; then cp /mnt/tunnel/id_rsa /root/.ssh/id_rsa; chown root:root /root/.ssh/id_rsa; chmod 600 /root/.ssh/id_rsa; fi; exec autossh -M 0 -N -v -D 0.0.0.0:1080 -E /dev/stdout vps-tunnel"]
